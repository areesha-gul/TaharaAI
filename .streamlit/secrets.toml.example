# Copy this file to .streamlit/secrets.toml and replace the values below.
# Keep this file out of Git. It is already ignored by .gitignore.

DB_HOST = "your-supabase-host"
DB_PORT = "5432"
DB_SSLMODE = "require"
DB_NAME = "postgres"
DB_USER = "your-supabase-user"
DB_PASSWORD = "your-supabase-password"

LLM_BASE_URL = "https://your-openai-compatible-endpoint/v1"
LLM_MODEL = "your-model-name"
LLM_API_KEY = "your-api-key"
LLM_TIMEOUT = "600"
MAX_EVIDENCE_CHARS = "6000"
OLLAMA_NUM_CTX = "4096"
LLM_MAX_TOKENS = "512"

# Optional tuning:
ENABLE_RERANK = "false"
RETRIEVE_TOP_K = "100"
RERANK_TOP_K = "5"
MIN_RETRIEVAL_SCORE = "0.35"
